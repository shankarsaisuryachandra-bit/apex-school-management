{
  "info": {
    "name": "School Management System API",
    "description": "Complete REST API collection for BTech CSE Major Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Teacher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"teacher1\",\n  \"password\": \"teacher123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Management",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/dashboard/stats",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "dashboard", "stats"]
            }
          }
        },
        {
          "name": "Fee Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/fees/dashboard?academicYear=2025-2026",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "fees", "dashboard"],
              "query": [{ "key": "academicYear", "value": "2025-2026" }]
            }
          }
        },
        {
          "name": "Promotion Preview",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/promotions/preview?academicYear=2025-2026",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "promotions", "preview"]
            }
          }
        }
      ]
    },
    {
      "name": "Public CMS",
      "item": [
        {
          "name": "Get Hero Section",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/cms/hero",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cms", "hero"]
            }
          }
        },
        {
          "name": "Get Facilities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/cms/facilities",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "cms", "facilities"]
            }
          }
        }
      ]
    }
  ]
}
